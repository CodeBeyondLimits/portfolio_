# ==============================================================================
# RESEND EMAIL INTEGRATION CONFIGURATION
# ==============================================================================
# 1. Sign up for a free Resend account at: https://resend.com
# 2. Create your API Key under: https://resend.com/api-keys
# 3. Copy this file to '.env' and insert your real Resend API key below:

RESEND_API_KEY=re_your_api_key_here

# Destination Email (Where you receive messages from visitors)
CONTACT_EMAIL=sharshith346@gmail.com

# Sender Address
# For testing on Resend free tier without a custom domain, use:
# 'onboarding@resend.dev' (Delivers to the email address registered with your Resend account)
# For production with your verified domain (e.g. yourdomain.com):
# 'Portfolio Contact <contact@yourdomain.com>'
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Local Server Port (Defaults to 3000)
PORT=3000
